{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "watch",
			"type": "shell",
			"command": "pnpm dev --sourcemap",
			"isBackground": true,
			"problemMatcher": {
				"owner": "bunchee",
				"source": "bunchee",
				"fileLocation": "absolute",
				"pattern": [
					{
						"regexp": "\\[Error:\\s+(?:×\\s+)?(.+)$",
						"message": 1
					},
					{
						"regexp": "\\[([^\\[\\]]+\\.tsx?):(\\d+):(\\d+)\\]$",
						"file": 1,
						"line": 2,
						"column": 3
					}
				],
				"background": {
					"activeBegin": true,
					"beginsPattern": "Building\\.\\.\\.",
					"endsPattern": "Built in \\d+(\\.\\d+)?ms"
				}
			},
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
