{
	"name": "vscode-extension-vercel-ai",
	"private": true,
	"displayName": "Vercel AI Gateway",
	"description": "Use Vercel AI Gateway models in VS Code chat with your gateway API key or Vercel OIDC. Community extension, not made by Vercel.",
	"version": "0.18.2",
	"publisher": "SferaDev",
	"license": "MIT",
	"icon": "images/icon.png",
	"galleryBanner": {
		"color": "#ffffff",
		"theme": "light"
	},
	"pricing": "Free",
	"qna": "https://github.com/sferarc/vscode-ai-gateway/issues",
	"type": "module",
	"engines": {
		"vscode": "^1.137.0"
	},
	"categories": [
		"AI",
		"Chat"
	],
	"keywords": [
		"ai",
		"vercel",
		"chat",
		"gpt",
		"claude",
		"gemini",
		"llm",
		"tools",
		"copilot",
		"copilot-chat",
		"language-model",
		"byok",
		"ai-gateway",
		"vercel-ai-gateway",
		"anthropic",
		"openai",
		"google",
		"oidc"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sferarc/vscode-ai-gateway.git"
	},
	"homepage": "https://github.com/sferarc/vscode-ai-gateway#readme",
	"bugs": {
		"url": "https://github.com/sferarc/vscode-ai-gateway/issues"
	},
	"main": "./out/extension.js",
	"l10n": "./l10n",
	"activationEvents": [
		"onLanguageModelChatProvider:vercelAiGateway"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "%untrustedWorkspaces.description%",
			"restrictedConfigurations": [
				"vercelAiGateway.timeout",
				"vercelAiGateway.providerSort",
				"vercelAiGateway.providerOrder"
			]
		}
	},
	"contributes": {
		"authentication": [
			{
				"id": "vercelAiGateway",
				"label": "%authentication.label%"
			}
		],
		"languageModelChatProviders": [
			{
				"vendor": "vercelAiGateway",
				"displayName": "%chatProvider.displayName%",
				"icon": "$(triangle-up)"
			}
		],
		"languageModelTools": [
			{
				"name": "vercelAiGateway_status",
				"displayName": "%statusTool.displayName%",
				"toolReferenceName": "gatewayStatus",
				"canBeReferencedInPrompt": true,
				"icon": "$(triangle-up)",
				"userDescription": "%statusTool.userDescription%",
				"modelDescription": "Reads the Vercel AI Gateway credit balance left and used for the user's active session, its spend since the first of the month with the models it was spent on, the cost, serving provider and token counts of the last chat request that completed through this extension, and for each gateway model id passed in modelIds, its price per million input and output tokens and, when the gateway lists them, per million cache read and cache write tokens, its context window, and whether it supports tool calling, image input and reasoning. Use it before a long or expensive task, to compare the cost of gateway models, or to pick one that can call tools or read images, such as anthropic/claude-sonnet-4.5 against openai/gpt-5. To find model ids, pass search, such as claude or gpt: it lists up to 20 chat models whose id or name contains it, with the same details. It only reads and makes no chat request. Without modelIds or search it returns the balance, the spend, the last request's cost and how many chat models are available. Ids it does not know are reported as not listed. When the user is not signed in, or the gateway cannot be reached, it returns the step the user should take instead.",
				"tags": [
					"vercel-ai-gateway",
					"credits",
					"spend",
					"pricing"
				],
				"inputSchema": {
					"type": "object",
					"properties": {
						"modelIds": {
							"type": "array",
							"items": {
								"type": "string"
							},
							"maxItems": 20,
							"description": "Gateway model ids, in provider/model form such as anthropic/claude-sonnet-4.5, to report prices and context windows for."
						},
						"search": {
							"type": "string",
							"description": "Text to find in gateway model ids and names, case insensitive, such as claude or gpt-5. Lists up to 20 matching chat models with prices and context windows."
						}
					}
				}
			}
		],
		"commands": [
			{
				"command": "vercelAiGateway.manage",
				"title": "%command.manage.title%",
				"category": "%command.category%"
			},
			{
				"command": "vercelAiGateway.checkConnection",
				"title": "%command.checkConnection.title%",
				"category": "%command.category%"
			},
			{
				"command": "vercelAiGateway.showLogs",
				"title": "%command.showLogs.title%",
				"category": "%command.category%"
			},
			{
				"command": "vercelAiGateway.manageProviderKeys",
				"title": "%command.manageProviderKeys.title%",
				"category": "%command.category%"
			}
		],
		"walkthroughs": [
			{
				"id": "getStarted",
				"title": "%walkthrough.getStarted.title%",
				"description": "%walkthrough.getStarted.description%",
				"steps": [
					{
						"id": "getKey",
						"title": "%walkthrough.getStarted.getKey.title%",
						"description": "%walkthrough.getStarted.getKey.description%",
						"media": {
							"markdown": "media/walkthrough/get-key.md"
						},
						"completionEvents": [
							"onLink:https://vercel.com/docs/ai-gateway/authentication-and-byok",
							"onContext:vercelAiGateway.signedIn"
						]
					},
					{
						"id": "signIn",
						"title": "%walkthrough.getStarted.signIn.title%",
						"description": "%walkthrough.getStarted.signIn.description%",
						"media": {
							"markdown": "media/walkthrough/sign-in.md"
						},
						"completionEvents": [
							"onContext:vercelAiGateway.signedIn"
						]
					},
					{
						"id": "openChat",
						"title": "%walkthrough.getStarted.openChat.title%",
						"description": "%walkthrough.getStarted.openChat.description%",
						"media": {
							"markdown": "media/walkthrough/open-chat.md"
						},
						"completionEvents": [
							"onCommand:workbench.action.chat.open"
						]
					}
				]
			}
		],
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"vercelAiGateway.endpoint": {
					"type": "string",
					"scope": "machine",
					"default": "https://ai-gateway.vercel.sh",
					"description": "%config.endpoint.description%"
				},
				"vercelAiGateway.timeout": {
					"type": "number",
					"default": 30000,
					"description": "%config.timeout.description%",
					"minimum": 5000,
					"maximum": 300000
				},
				"vercelAiGateway.disallowPromptTraining": {
					"type": "boolean",
					"default": false,
					"description": "%config.disallowPromptTraining.description%"
				},
				"vercelAiGateway.zeroDataRetention": {
					"type": "boolean",
					"default": false,
					"description": "%config.zeroDataRetention.description%"
				},
				"vercelAiGateway.providerSort": {
					"type": "string",
					"enum": [
						"default",
						"cost",
						"ttft",
						"tps"
					],
					"enumDescriptions": [
						"%config.providerSort.enum.default%",
						"%config.providerSort.enum.cost%",
						"%config.providerSort.enum.ttft%",
						"%config.providerSort.enum.tps%"
					],
					"default": "default",
					"description": "%config.providerSort.description%"
				},
				"vercelAiGateway.providerOrder": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%config.providerOrder.description%"
				},
				"vercelAiGateway.providerOnly": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"scope": "application",
					"default": [],
					"description": "%config.providerOnly.description%"
				},
				"vercelAiGateway.reportingTags": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 64
					},
					"maxItems": 10,
					"scope": "application",
					"default": [],
					"description": "%config.reportingTags.description%"
				},
				"vercelAiGateway.reportingUser": {
					"type": "string",
					"maxLength": 256,
					"scope": "application",
					"default": "",
					"description": "%config.reportingUser.description%"
				},
				"vercelAiGateway.quotaEntity": {
					"type": "string",
					"scope": "application",
					"default": "",
					"description": "%config.quotaEntity.description%"
				},
				"vercelAiGateway.fallbackModels": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"scope": "application",
					"default": [],
					"description": "%config.fallbackModels.description%"
				},
				"vercelAiGateway.inferenceRegion": {
					"type": "string",
					"enum": [
						"global",
						"us",
						"eu",
						"au",
						"jp"
					],
					"enumDescriptions": [
						"%config.inferenceRegion.enum.global%",
						"%config.inferenceRegion.enum.us%",
						"%config.inferenceRegion.enum.eu%",
						"%config.inferenceRegion.enum.au%",
						"%config.inferenceRegion.enum.jp%"
					],
					"scope": "application",
					"default": "global",
					"description": "%config.inferenceRegion.description%"
				},
				"vercelAiGateway.excludeQuantizations": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^[a-zA-Z0-9._-]{1,32}$"
					},
					"scope": "application",
					"default": [],
					"description": "%config.excludeQuantizations.description%"
				},
				"vercelAiGateway.requiredCapabilities": {
					"type": "array",
					"items": {
						"type": "string",
						"enum": [
							"free",
							"implicit-caching",
							"reasoning",
							"structured-output",
							"tool-use",
							"vision"
						],
						"enumDescriptions": [
							"%config.requiredCapabilities.items.enum.free%",
							"%config.requiredCapabilities.items.enum.implicit-caching%",
							"%config.requiredCapabilities.items.enum.reasoning%",
							"%config.requiredCapabilities.items.enum.structured-output%",
							"%config.requiredCapabilities.items.enum.tool-use%",
							"%config.requiredCapabilities.items.enum.vision%"
						]
					},
					"uniqueItems": true,
					"scope": "application",
					"default": [],
					"description": "%config.requiredCapabilities.description%"
				},
				"vercelAiGateway.serviceTier": {
					"type": "string",
					"enum": [
						"default",
						"flex",
						"priority"
					],
					"enumDescriptions": [
						"%config.serviceTier.enum.default%",
						"%config.serviceTier.enum.flex%",
						"%config.serviceTier.enum.priority%"
					],
					"scope": "application",
					"default": "default",
					"description": "%config.serviceTier.description%"
				},
				"vercelAiGateway.reasoningEffort": {
					"type": "string",
					"enum": [
						"provider-default",
						"none",
						"minimal",
						"low",
						"medium",
						"high",
						"xhigh",
						"max"
					],
					"enumDescriptions": [
						"%config.reasoningEffort.enum.provider-default%",
						"%config.reasoningEffort.enum.none%",
						"%config.reasoningEffort.enum.minimal%",
						"%config.reasoningEffort.enum.low%",
						"%config.reasoningEffort.enum.medium%",
						"%config.reasoningEffort.enum.high%",
						"%config.reasoningEffort.enum.xhigh%",
						"%config.reasoningEffort.enum.max%"
					],
					"scope": "application",
					"default": "provider-default",
					"description": "%config.reasoningEffort.description%"
				},
				"vercelAiGateway.sessionAffinity": {
					"type": "boolean",
					"scope": "application",
					"default": true,
					"description": "%config.sessionAffinity.description%"
				},
				"vercelAiGateway.byokProviderTimeouts": {
					"type": "object",
					"scope": "application",
					"default": {},
					"additionalProperties": {
						"type": "number",
						"minimum": 1000,
						"maximum": 789000
					},
					"description": "%config.byokProviderTimeouts.description%"
				},
				"vercelAiGateway.webSearch": {
					"type": "boolean",
					"scope": "application",
					"default": false,
					"description": "%config.webSearch.description%"
				}
			}
		}
	},
	"scripts": {
		"check": "pnpm lint && pnpm exec lefthook validate && pnpm knip && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e && pnpm package",
		"build": "NODE_ENV=production bunchee ./src/extension.ts --format cjs --no-external",
		"dev": "bunchee ./src/extension.ts --format cjs --watch",
		"test": "vitest run src",
		"test:e2e": "node e2e/run.mjs",
		"test:watch": "vitest",
		"prepackage": "pnpm run build",
		"package": "vsce package --no-dependencies",
		"release": "./scripts/release.sh",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"fix": "biome check --write .",
		"knip": "knip && knip --production --strict",
		"l10n:export": "vscode-l10n-dev export --outDir ./l10n ./src && biome format --write l10n",
		"changeset": "changeset"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@changesets/cli": "catalog:",
		"@types/json-schema": "catalog:",
		"@types/node": "catalog:",
		"@types/vscode": "1.137.0",
		"@typescript/typescript6": "catalog:",
		"@vscode/l10n-dev": "catalog:",
		"@vscode/test-electron": "catalog:",
		"@vscode/vsce": "catalog:",
		"bunchee": "catalog:",
		"knip": "catalog:",
		"lefthook": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@ai-sdk/gateway": "catalog:",
		"ai": "catalog:"
	},
	"packageManager": "pnpm@12.14.0"
}
